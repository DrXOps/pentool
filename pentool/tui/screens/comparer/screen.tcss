ComparerScreen {
    layout: vertical;
    width: 1fr;
    height: 1fr;
}

/* ── Stat bar ────────────────────────────────────────────────────────────── */
ComparerScreen #cmp-stat-bar {
    height: 1;
    background: transparent;
    padding: 0 1;
    border-bottom: solid $primary 35%;
}
ComparerScreen #cmp-stat-bar ToolbarButton {
    /* The row is one line tall; without an explicit height the buttons are clipped and
       the toolbar looks empty ("в компарере пропали инструменты"). */
    height: 1;
    width: auto;
    padding: 0 1;
    background: transparent;
}

ComparerScreen #cmp-stats {
    width: 1fr;
}

/* ── Edit area ───────────────────────────────────────────────────────────── */
ComparerScreen #cmp-edit-area {
    height: 1fr;
    layout: horizontal;
}
ComparerScreen #cmp-left-col {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}
ComparerScreen #cmp-right-col {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}
ComparerScreen #cmp-left,
ComparerScreen #cmp-right {
    height: 1fr;
}

/* ── Diff area ───────────────────────────────────────────────────────────── */
ComparerScreen #cmp-diff-area {
    height: 10;
    layout: vertical;
}
ComparerScreen #cmp-diff-log {
    height: 1fr;
    padding: 0 1;
}