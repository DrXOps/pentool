ProxyScreen {
    layout: vertical;
}
ProxyScreen #proxy-subtabs {
    height: 1fr;
}
/* The sub-tab strip is drawn in the module header (chips) — see
   `pentool/tui/header.py`. Keeping it here too would show the tabs twice and
   cost a row of content for nothing. */
ProxyScreen #proxy-subtabs > ContentTabs {
    display: none;
}
ProxyScreen #body {
    height: 1fr;
    layout: horizontal;
}
ProxyScreen #main-panel {
    width: 1fr;
    height: 100%;
    layout: vertical;
}
ProxyScreen #table-area {
    height: 1fr;
    min-height: 5;
}
ProxyScreen #filter-bar {
    /* Было 1; карточка с рамкой требует auto (рамка = +2 строки). */
    height: auto;
}
/* Table + "showing N of M" strip live in one card under the filter bar; the
   bar keeps its own white frame, so the two blocks read as stacked cards
   rather than a frame inside a frame. */
ProxyScreen #history-card,
ProxyScreen #ws-history-card {
    height: 1fr;
    min-height: 4;
}
/* Panels that are themselves the card (no wrapper): `ContentPanel` ships
   `height: auto`, and with the border that is taller than its area — the last
   body line got clipped. Fill the area instead. */
ProxyScreen #intercept-panel,
ProxyScreen #ws-msg-panel {
    height: 1fr;
}
ProxyScreen #request-list {
    height: 1fr;
}
ProxyScreen .history-count {
    height: 1;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
    text-align: right;
}
ProxyScreen #req-panel {
    width: 50%;
    height: 100%;
    layout: vertical;
}
ProxyScreen #resp-panel {
    width: 1fr;
    height: 100%;
    layout: vertical;
}
ProxyScreen #req-panel HttpView,
ProxyScreen #ws-req-panel HttpView,
ProxyScreen #resp-panel HttpView,
ProxyScreen #ws-resp-panel HttpView,
ProxyScreen #intercept-sent-panel HttpView,
ProxyScreen #intercept-resp-panel HttpView {
    height: 1fr;
}
ProxyScreen InspectorPanel {
    width: 25%;
    height: 100%;
    display: none;
}
ProxyScreen InspectorPanel.-visible {
    display: block;
}
/* The narrow-terminal rule for the inspector lives in app.tcss, next to
   NARROW_BREAKPOINT: Textual prefixes the first selector of a widget's
   DEFAULT_CSS with the widget's own type (textual/css/parse.py:174), so a
   rule rooted at `Screen` would become `ProxyScreen Screen …` and never
   match. Screen-scoped rules whose root is an ancestor belong in app.tcss. */
ProxyScreen #intercept-req-area {
    height: 2fr;
    min-height: 5;
}
ProxyScreen #intercept-bottom-area {
    height: 1fr;
    min-height: 5;
    layout: horizontal;
}
ProxyScreen #intercept-sent-panel {
    width: 1fr;
    height: 100%;
    layout: vertical;
}
ProxyScreen #intercept-resp-panel {
    width: 1fr;
    height: 100%;
    layout: vertical;
}
ProxyScreen #intercept-sent-req {
    height: 1fr;
    border: none;
}
ProxyScreen #intercept-resp-viewer {
    height: 1fr;
    border: none;
}
/* Forward / Drop / Special moved to the module header (see
   `pentool/tui/header.py`), so the panel toolbar is gone; the hint keeps its
   own row. */
ProxyScreen #intercept-hint {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}
ProxyScreen #intercept-hint {
    color: $text-muted;
    padding: 0 1;
    height: 1;
}
ProxyScreen #ws-body {
    height: 1fr;
    layout: horizontal;
}
ProxyScreen #ws-main-panel {
    width: 1fr;
    height: 100%;
    layout: vertical;
}
ProxyScreen #ws-filter-bar {
    /* Was 1 from the service-strip days: with the card border the content row
       got zero height and the WS filters were not drawn at all. */
    height: auto;
}
ProxyScreen #ws-table-area {
    height: 1fr;
    min-height: 5;
}
ProxyScreen #ws-request-list {
    height: 1fr;
}
ProxyScreen #ws-detail-area {
    height: 1fr;
    min-height: 5;
    layout: horizontal;
}
ProxyScreen #ws-req-panel {
    width: 50%;
    height: 100%;
    layout: vertical;
}
ProxyScreen #ws-resp-panel {
    width: 1fr;
    height: 100%;
    layout: vertical;
}
