TargetScreen {
    layout: vertical;
    width: 1fr;
    height: 1fr;
}
TargetScreen #tgt-config-row {
    /* A row of controls, not a pane: without a height it defaulted to 1fr and took
       half the screen, pushing the Site Map card down (seen in the app by the owner). */
    height: auto;
    align-vertical: middle;
}
TargetScreen #main-split {
    layout: horizontal;
    height: 1fr;
}
TargetScreen #site-tree {
    width: 2fr;
    height: 1fr;
    border: round $foreground;
    /* Textual's Tree paints its own surface, which inside a transparent card
       read as a lighter rectangle — the card looked broken (same fix as the
       dashboard's project tree). */
    background: transparent;
}
TargetScreen #detail-panel {
    width: 1fr;
    height: 1fr;
    border: round $foreground;
    layout: vertical;
    padding: 0 1;
}
