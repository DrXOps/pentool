TargetScreen {
    layout: vertical;
    width: 1fr;
    height: 1fr;
}
TargetScreen #main-split {
    layout: horizontal;
    height: 1fr;
}
TargetScreen #site-tree {
    width: 2fr;
    height: 1fr;
    border: solid $primary-darken-3;
}
TargetScreen #detail-panel {
    width: 1fr;
    height: 1fr;
    border: solid $primary-darken-3;
    layout: vertical;
    padding: 0 1;
}
