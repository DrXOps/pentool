SpiderScreen {
    layout: vertical;
    width: 1fr;
    height: 1fr;
}
SpiderScreen #spider-toolbar {
    height: 3;
    width: 100%;
    background: $panel;
    layout: horizontal;
    padding: 0 1;
    align: left middle;
    border-bottom: solid $primary-darken-2;
}
SpiderScreen #spider-toolbar Button {
    height: 2;
    min-width: 14;
    margin-right: 1;
    border: none;
    padding: 0 1;
}
SpiderScreen #config-panel {
    height: auto;
    layout: horizontal;
    padding: 0 1;
    margin: 1 0;
    border-bottom: solid $primary-darken-3;
    padding-bottom: 1;
}
SpiderScreen #url-group {
    width: 1fr;
    height: auto;
    layout: vertical;
}
SpiderScreen #settings-group {
    width: 45;
    height: auto;
    layout: vertical;
    margin-left: 2;
}
SpiderScreen #config-panel Label {
    height: 1;
    color: $text-muted;
    margin-bottom: 0;
}
SpiderScreen #target-url {
    width: 100%;
    margin-bottom: 1;
}
SpiderScreen .config-row {
    height: 1;
    layout: horizontal;
    margin-bottom: 0;
}
SpiderScreen .config-row Label {
    width: 14;
    color: $text-muted;
}
SpiderScreen .config-row Input {
    width: 8;
}
SpiderScreen Checkbox {
    height: 1;
    margin-left: 1;
}
SpiderScreen #progress-area {
    height: 2;
    layout: horizontal;
    padding: 0 1;
    align: left middle;
}
SpiderScreen #spider-progress {
    width: 1fr;
    height: 1;
}
SpiderScreen #progress-label {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $text-muted;
}
SpiderScreen #spider-hint {
    height: 1;
    padding: 0 1;
    color: $text-muted;
    text-align: right;
    width: auto;
}
SpiderScreen TabbedContent {
    height: 1fr;
}
SpiderScreen TabPane {
    padding: 0;
}
SpiderScreen #site-tree {
    height: 1fr;
    border: solid $primary-darken-3;
}
SpiderScreen #endpoints-log {
    height: 1fr;
    border: solid $primary-darken-3;
}
SpiderScreen #forms-log {
    height: 1fr;
    border: solid $primary-darken-3;
}
SpiderScreen #js-log {
    height: 1fr;
    border: solid $primary-darken-3;
}
SpiderScreen #btn-scan-found {
    margin: 1;
    min-width: 20;
}
SpiderScreen .section-label {
    height: 1;
    color: $text-muted;
    padding: 0 1;
}
/* toolbar-sep fix — Static не наследует DEFAULT_CSS ToolbarButton */
.toolbar-sep { width: auto; }
