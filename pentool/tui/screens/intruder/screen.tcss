IntruderScreen {
    layout: vertical;
}

/* ── Per-tab widget styles (по классам, не id) ────────────────────── */

IntruderScreen .intruder-template-panel {
    height: 1fr;
}
IntruderScreen .intruder-template-panel .text-area--selection {
    background: $primary 70%;
}

IntruderScreen .intruder-payloads-panel {
    width: 40%;
    height: 100%;
    layout: vertical;
}

IntruderScreen .intruder-payload-list {
    height: 1fr;
}

/* ── Global sections (остаются по id) ────────────────────────────── */

IntruderScreen #attack-type-desc {
    width: 1fr;
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

IntruderScreen .section-title {
    height: 1;
    background: $primary-darken-3;
    color: $text-muted;
    padding: 0 1;
}

IntruderScreen #payload-buttons-toolbar .pro-locked {
    color: $text-muted;
    text-style: dim;
}

IntruderScreen .payload-count-label {
    height: 1;
    padding: 0 1;
    background: $panel;
}

IntruderScreen .proc-bar {
    height: 1;
    layout: horizontal;
    background: $panel;
    padding: 0 1;
    align: left middle;
}

IntruderScreen .proc-bar Label {
    width: auto;
    color: $text-muted;
    padding: 0 0 0 1;
}

/* ── Results area (global) ────────────────────────────────────────── */

IntruderScreen #results-area {
    height: 1fr;
    min-height: 5;
    layout: vertical;
}

IntruderScreen #progress-row {
    height: 1;
    background: $panel;
    padding: 0 1;
    layout: horizontal;
    align: left middle;
}

IntruderScreen #progress-label {
    width: auto;
    color: $text-muted;
    padding: 0 1;
}

IntruderScreen #results-table {
    height: 1fr;
}

/* ── Filter bar ──────────────────────────────────────────────────── */

IntruderScreen #results-filter-bar {
    height: 2;
    layout: horizontal;
    background: $panel;
    padding: 0 1;
    align: left middle;
}
IntruderScreen #results-filter-bar Label {
    width: auto;
    color: $text-muted;
    padding: 0 1;
}
IntruderScreen #results-filter-bar Input {
    width: 8;
    background: $surface;
}
IntruderScreen #results-filter-bar Button {
    width: auto;
    min-width: 8;
    height: 1;
    padding: 0 1;
    border: none;
}

IntruderScreen #grep-bar {
    height: 1;
    layout: horizontal;
    background: $panel;
    padding: 0 1;
    align: left middle;
}
IntruderScreen #grep-bar Label {
    width: auto;
    color: $text-muted;
    padding: 0 1;
    height: 1;
}
IntruderScreen #grep-bar Input {
    width: 24;
    background: $surface;
}
IntruderScreen #grep-bar Button {
    width: auto;
    min-width: 8;
    height: 1;
    padding: 0 1;
    border: none;
}

/* ── Dialogs ──────────────────────────────────────────────────────── */

_InputDialog {
    align: center middle;
}
_InputDialog #dialog {
    width: 50;
    height: auto;
    border: solid $primary;
    background: $surface;
    padding: 1 2;
}
_InputDialog #prompt-label {
    height: 1;
    color: $text-muted;
    margin-bottom: 1;
}
_InputDialog Input {
    width: 100%;
    margin-bottom: 1;
}
_InputDialog #buttons {
    height: 1;
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}
_InputDialog #buttons ToolbarButton {
    margin: 0 0 0 1;
}

/* ── Toolbar inputs ────────────────────────────────────────────────── */

IntruderScreen #toolbar Label.toolbar-label {
    width: auto;
    padding: 0 1;
    color: $text-muted;
}
IntruderScreen #toolbar Input {
    width: 6;
    height: 1;
    border: solid $primary-darken-2;
    padding: 0 1;
    background: $surface;
}

/* ── Detail panel ────────────────────────────────────────────────── */

IntruderScreen #intruder-detail-panel {
    height: 20;
    layout: horizontal;
    border-top: solid $primary;
    display: none;
}

IntruderScreen .detail-col {
    width: 1fr;
    layout: vertical;
}

IntruderScreen .detail-label {
    height: 1;
    background: $panel;
    color: $text;
    padding: 0 1;
}

IntruderScreen .detail-view {
    height: 1fr;
}