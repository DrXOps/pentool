IntruderScreen {
    layout: vertical;
}

/* ── Tabs ────────────────────────────────────────────────────────────── */
IntruderScreen TabbedContent {
    height: 1fr;
}
IntruderScreen TabbedContent ContentSwitcher {
    height: 1fr;
}
IntruderScreen TabbedContent ContentTabs {
    background: $panel;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-size: 0 0;
}
IntruderScreen TabbedContent ContentTabs Tabs {
    background: $panel;
    min-width: 100%;
    max-width: 100%;
    overflow-x: auto;
}
IntruderScreen TabbedContent ContentTabs Tabs Tab {
    max-width: 30;
}

/* ── Tab body (вертикальная стопка всего таба) ──────────────────────── */
IntruderScreen .intruder-tab-body {
    layout: vertical;
    height: 1fr;
}

/* ── Global toolbar (табы + атака) ───────────────────────────────────── */
IntruderScreen #intruder-global-toolbar {
    height: 1;
}
IntruderScreen #intruder-global-toolbar Label.toolbar-label {
    width: auto;
    padding: 0 1;
    color: $text-muted;
}
IntruderScreen #intruder-global-toolbar Input {
    width: 6;
    height: 1;
    border: solid $primary-darken-2;
    padding: 0 1;
    background: $surface;
}
IntruderScreen #intruder-global-toolbar #intruder-turbo {
    width: auto;
}
/* StartStopWidget не должен растягиваться на всю строку toolbar */
IntruderScreen #intruder-start-stop {
    width: auto;
}
IntruderScreen #intruder-start-stop Toolbar {
    width: auto;
}
IntruderScreen #intruder-start-stop ToolbarButton {
    width: auto;
}

/* ── Per-tab attack description ─────────────────────────────────────── */
/* Per-tab widget: id is ``attack-type-desc-<tab_id>`` (IntruderScreen._wid)
   and the matching ``attack-type-desc`` class rides along, because Textual 8
   has no attribute selectors ( ``[id^=…]`` is a parse error, verified by
   test_intruder_tabs.py after the first attempt). */
IntruderScreen .attack-type-desc {
    width: 1fr;
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

/* ── Top area (template + payloads side by side) ────────────────────── */
IntruderScreen .intruder-top-area {
    layout: horizontal;
    height: 1fr;
    min-height: 8;
}

IntruderScreen .intruder-positions-panel {
    width: 1fr;
    height: 100%;
    layout: vertical;
}
IntruderScreen .intruder-template-panel {
    width: 100%;
    height: 100%;
    min-height: 3;
}
IntruderScreen .intruder-template-panel .text-area--selection {
    background: $primary 70%;
}

IntruderScreen .intruder-body-right {
    width: 1fr;
    height: 100%;
    layout: vertical;
}

/* ── Payloads panel ─────────────────────────────────────────────────── */
IntruderScreen .intruder-payloads-panel {
    width: 100%;
    height: 1fr;
    layout: vertical;
}

IntruderScreen .intruder-payload-list {
    height: 1fr;
}

IntruderScreen .section-title {
    height: 1;
    background: $primary-darken-3;
    color: $text-muted;
    padding: 0 1;
}

IntruderScreen .payload-count-label {
    height: 1;
    padding: 0 1;
    background: $panel;
}

/* ── Processing bar ─────────────────────────────────────────────────── */
IntruderScreen .proc-bar {
    height: 1;
    layout: horizontal;
    background: $panel;
    padding: 0 1;
    align: left middle;
}

IntruderScreen .proc-bar Label {
    width: auto;
    color: $text-muted;
    padding: 0 0 0 1;
}

/* ── Results area (per-tab) ─────────────────────────────────────────── */
IntruderScreen .intruder-results-area {
    height: 1fr;
    min-height: 5;
    layout: vertical;
}

IntruderScreen .progress-row {
    height: 1;
    background: $panel;
    padding: 0 1;
    layout: horizontal;
    align: left middle;
}

IntruderScreen .progress-row .progress-label {
    width: auto;
    color: $text-muted;
    padding: 0 1;
}

IntruderScreen .intruder-results-area DataTable {
    height: 1fr;
}

/* ── Filter bar (per-tab) ──────────────────────────────────────────── */
/* Height and inner layout belong to IntruderFilterBar's own DEFAULT_CSS
   (widgets/intruder_filter_bar.py). Only the id-level background/padding is
   owned here; the inner Label/Input/Button rules moved with the widget. */
IntruderScreen IntruderFilterBar {
    height: 2;
    background: $panel;
    padding: 0 1;
}

/* ── Detail panel (per-tab) ────────────────────────────────────────── */
IntruderScreen .intruder-detail-panel {
    height: 20;
    layout: horizontal;
    border-top: solid $primary;
    display: none;
}

IntruderScreen .detail-col {
    width: 1fr;
    layout: vertical;
}

IntruderScreen .detail-view {
    height: 1fr;
}

/* ── Dialogs ────────────────────────────────────────────────────────── */
_InputDialog {
    align: center middle;
}
_InputDialog #dialog {
    width: 50;
    height: auto;
    border: solid $primary;
    background: $surface;
    padding: 1 2;
}
_InputDialog #prompt-label {
    height: 1;
    color: $text-muted;
    margin-bottom: 1;
}
_InputDialog Input {
    width: 100%;
    margin-bottom: 1;
}
_InputDialog #buttons {
    height: 1;
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}
_InputDialog #buttons ToolbarButton {
    margin: 0 0 0 1;
}