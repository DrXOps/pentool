SequencerScreen {
    layout: vertical;
    width: 1fr;
    height: 1fr;
}

/* ── Config row ──────────────────────────────────────────────────────────── */
SequencerScreen #seq-config-row {
    height: 2;
    layout: horizontal;
    align: left middle;
    padding: 0 1;
    background: transparent;
    border-bottom: solid $primary 35%;
}
SequencerScreen .seq-cfg-label {
    width: auto;
    color: $text-muted;
    padding: 0 1 0 0;
}
SequencerScreen #btn-seq-source {
    width: auto;
    padding: 0 1;
    background: transparent;
}
SequencerScreen #seq-param-input {
    width: 20;
    background: transparent;
    margin: 0 2 0 0;
}
SequencerScreen #seq-param-input:focus {
    background: transparent;
}
SequencerScreen #seq-counter {
    width: auto;
    color: $primary;
    padding: 0 2;
}

/* ── Summary bar ─────────────────────────────────────────────────────────── */
SequencerScreen #seq-summary-bar {
    height: 1;
    background: transparent;
    padding: 0 1;
    border-bottom: solid $primary 35%;
}
SequencerScreen #seq-summary {
    width: 1fr;
    color: $text-muted;
}

/* ── Main area ───────────────────────────────────────────────────────────── */
SequencerScreen #seq-main-area {
    height: 1fr;
    layout: horizontal;
}

/* Left column: manual token input */
SequencerScreen #seq-input-col {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}
SequencerScreen .seq-col-label {
    /* height/background/padding — из общего .panel-title (F-038). */
    color: $text-muted;
    text-style: bold;
}
SequencerScreen #seq-token-area {
    height: 1fr;
}

/* Right column: analysis */
SequencerScreen #seq-analysis-col {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}
SequencerScreen #seq-analysis-log {
    height: 1fr;
    padding: 0 1;
}

/* ── Entropy gauge ───────────────────────────────────────────────────────── */
SequencerScreen #seq-gauge-area {
    height: 5;
    layout: vertical;
    padding: 0 1;
    background: transparent;
}
SequencerScreen #seq-gauge-label {
    height: 1;
    color: $text-muted;
    background: transparent;
    padding: 0 0;
}
SequencerScreen #seq-gauge {
    width: 1fr;
    height: 1;
    color: $success;
}
SequencerScreen #seq-assessment {
    height: 1;
    color: $accent;
    text-style: bold;
}
SequencerScreen #seq-bits-label {
    height: 1;
    color: $text-muted;
}
