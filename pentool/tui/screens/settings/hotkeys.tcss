HotkeySettingsScreen {
    layout: vertical;
    padding: 1 2;
}
HotkeySettingsScreen .section-title {
    height: 1;
    color: $primary;
    margin-bottom: 1;
}
HotkeySettingsScreen .hotkey-hint {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}
HotkeySettingsScreen DataTable {
    height: 1fr;
}
