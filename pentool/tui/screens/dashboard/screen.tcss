LiveChart {
    height: 7;
    width: 1fr;
    border: round $foreground;
    background: transparent;
    padding: 0 1;
}
LiveChart #chart-title {
    height: auto;
    color: $accent;
    text-style: bold;
}
LiveChart #chart-spark {
    height: auto;
    color: $success;
}
LiveChart #chart-axis {
    height: auto;
    color: $text-muted;
}
LiveChart #chart-stats {
    height: auto;
    color: $text-muted;
}
LiveChart #chart-meta {
    height: auto;
    color: $text-muted;
}
LiveChart #chart-summary {
    height: auto;
    color: $text-muted;
}

ThreatMeter {
    height: 100%;
    width: 1fr;
    border: round $foreground;
    background: transparent;
    padding: 0 1;
}
ThreatMeter #tm-title {
    height: auto;
    color: $accent;
    text-style: bold;
}
ThreatMeter #tm-gauge {
    height: auto;
}
ThreatMeter #tm-breakdown {
    height: auto;
    color: $text-muted;
}
ThreatMeter #tm-top {
    height: auto;
    color: $text-muted;
}
ThreatMeter #tm-hint {
    height: auto;
    color: $text-muted;
    text-style: dim;
}

SeverityMatrix {
    height: 1fr;
    width: 1fr;
    border: round $foreground;
    background: transparent;
    padding: 0 1;
}
SeverityMatrix #mx-body {
    height: 1fr;
}

DashboardScreen {
    layout: vertical;
    width: 1fr;
    height: 1fr;
    background: transparent;
}
DashboardScreen #logo-bar {
    height: 9;
    background: transparent;
    border-bottom: solid $primary-darken-3;
    align: center middle;
    padding: 0 2;
}
DashboardScreen #logo {
    width: 100%;
    text-align: center;
}
DashboardScreen #top-row {
    height: 9;
    layout: horizontal;
}
DashboardScreen #top-row LiveChart {
    width: 1fr;
    height: 1fr;
    margin-right: 1;
}
DashboardScreen #top-row ThreatMeter {
    width: 1fr;
    height: 1fr;
    margin-right: 1;
}
DashboardScreen #top-row ResourceMonitor {
    width: 1fr;
    height: 1fr;
    border: round $foreground;
    background: transparent;
    padding: 0 1;
}
DashboardScreen #dash-resources {
    height: 1fr;
}
DashboardScreen #main-area {
    height: 1fr;
    layout: horizontal;
}
/* Left column — Projects */
DashboardScreen #left-pane {
    width: 32%;
    height: 1fr;
    min-height: 16;
    border: round $foreground;
    background: transparent;
    padding: 0 1;
    layout: vertical;
}
DashboardScreen #pp-title {
    height: 2;
    color: $accent;
    text-style: bold;
    border-bottom: solid $primary-darken-3;
}
DashboardScreen #project-tree {
    height: 1fr;
    min-height: 5;
    /* Tree paints its own surface by default; inside a transparent card that
       read as a lighter rectangle — the card looked broken. */
    background: transparent;
}
DashboardScreen #pp-actions {
    height: 3;
    layout: horizontal;
    border-top: solid $primary-darken-3;
}
DashboardScreen #pp-actions ToolbarButton {
    height: 3;
    padding: 0 1;
}
DashboardScreen #hk-panel {
    height: auto;
    color: $text-muted;
    border-top: solid $primary-darken-3;
    padding: 1 0 0 0;
    text-style: dim;
}
/* Right column */
DashboardScreen #right-col {
    width: 1fr;
    height: 1fr;
    layout: vertical;
    margin-left: 1;
}
/* Upper part of right column: Feed + Status */
DashboardScreen #mid-row {
    height: 9;
    layout: horizontal;
}
DashboardScreen #feed-panel {
    width: 1fr;
    height: 1fr;
    border: round $foreground;
    background: transparent;
    padding: 0 1;
    layout: vertical;
}
DashboardScreen #feed-panel-title {
    height: 1;
    color: $accent;
    text-style: bold;
}
DashboardScreen #feed-log {
    height: 1fr;
    /* Same as the project tree: RichLog's own surface made the LIVE FEED card
       look filled while its neighbours are transparent. */
    background: transparent;
}
DashboardScreen #status-panel {
    width: 22;
    height: 1fr;
    border: round $foreground;
    background: transparent;
    padding: 0 1;
    layout: vertical;
    margin-left: 1;
}
DashboardScreen #status-panel-title {
    height: 1;
    color: $accent;
    text-style: bold;
}
DashboardScreen #status-panel .led-item {
    height: 1;
    color: $text-muted;
}
/* Lower part of right column: matrix (2/3) + subscription (1/3). The matrix used
   to own the whole width and height here; it is a heatmap, not the main content
   of the screen, so it makes room for the licence card. */
DashboardScreen #bottom-row {
    height: 1fr;
    layout: horizontal;
}
DashboardScreen #matrix-col {
    width: 2fr;
    height: 1fr;
    /* Without a floor the matrix collapsed to its frame (0 content rows) on a
       40-row terminal and showed an empty card. It needs the header, the column
       row and a few finding rows. */
    min-height: 5;
    border: round $foreground;
    background: transparent;
}
DashboardScreen #matrix-col SeverityMatrix {
    height: 1fr;
    width: 1fr;
    border: none;
}
DashboardScreen #subscription-col {
    width: 1fr;
    height: 1fr;
    min-height: 5;
    margin-left: 1;
    border: round $foreground;
    background: transparent;
    padding: 0 1;
    layout: vertical;
}
DashboardScreen #subscription-title {
    height: 1;
    color: $accent;
    text-style: bold;
}
DashboardScreen #subscription-body {
    height: 1fr;
    color: $text-muted;
}
