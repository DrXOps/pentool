ModuleTabs {
    /* 2 строки: подписи вкладок + линия под ними. Раньше было 3 — третья
       строка уходила под `Underline`, который теперь скрыт (см. app.tcss). */
    height: 2;
    width: 100%;
    /* No panel colour: the chrome (module strip, header row, footer) sits on the
       window background and is separated by lines, not by shifting shades —
       cards below stay the only filled blocks. */
    background: transparent;
    /* Тот же цвет, что у рамки карточек: верх приложения больше не спорит
       с блоками под ним. */
    border-bottom: solid $primary 35%;
    layout: horizontal;
}
ModuleTabs Tabs {
    width: 1fr;
}
ModuleTabs #tooltip2 {
    height: 1;
    width: auto;
    padding: 0 1;
    dock: right;
    content-align: right middle;
    background: $panel;
    display: none;
}

/* Locked tab (Scanner without license) */
ModuleTabs Tab.tab-locked {
    color: $text-disabled;
    text-style: italic;
}
