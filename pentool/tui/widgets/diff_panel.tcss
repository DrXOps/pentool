DiffPanel {
    width: 30%;
    height: 100%;
    display: none;
    background: $panel;
    border-left: solid $primary-darken-2;
    layout: vertical;
}
DiffPanel.-visible {
    display: block;
}
DiffPanel #diff-panel-title {
    /* height/background/padding — из общего .panel-title (F-038). */
    color: $text-muted;
}
DiffPanel #diff-panel-log {
    height: 1fr;
}
