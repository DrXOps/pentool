ToolbarButton {
    height: 1;
    width: auto;
    padding: 0 1;
    color: $text;
    background: $panel;
    pointer: pointer;  /* buttons — pointing hand cursor */
}
ToolbarButton:hover {
    background: $primary-darken-1;
    color: $text;
}
ToolbarButton.active {
    color: $success;
}
ToolbarButton.inactive {
    color: $error;
}
ToolbarButton.disabled {
    color: $text-disabled;
    pointer: not-allowed;
}
ToolbarButton.warn {
    color: $warning;
}
ToolbarButton.pro-locked {
    color: $text-muted;
    text-style: dim;
}
/* ContentPanel wrap toggle sets these classes (widgets/content_panel.py). */
ToolbarButton.variant-success {
    color: $success;
}
ToolbarButton.variant-warning {
    color: $warning;
}
ToolbarButton.variant-error {
    color: $error;
}

/* Common toolbar separator — used across all screens */
.toolbar-sep {
    width: auto;
    color: $primary-darken-2;
}
