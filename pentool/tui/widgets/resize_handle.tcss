ResizeHandle {
    /* 1 column, transparent, drawn as the same thin line as the horizontal
       divider: the old 2-column $primary-darken-2 bar read as a thick blue
       stripe between two cards. Grab area is helped by the resize cursor and the
       hover colour, not by width — the thickness is configurable
       (`resize_handle_thickness`, default 1).
       Height is `1fr`, not `100%`: the divider must stretch to fill whatever the
       row gives it, and `100%` did not always resolve against the parent's full
       height (the line appeared cut short). */
    width: 1;
    height: 1fr;
    background: transparent;
    color: $primary-darken-1;
    pointer: ew-resize;  /* horizontal divider — bidirectional horizontal arrow */
}
ResizeHandle:hover {
    background: transparent;
    color: $primary;
}
ResizeHandle.-dragging {
    background: transparent;
    color: $accent;
    pointer: grabbing;
}
ResizeHandle.-vertical {
    width: 100%;
    height: 1;
    background: transparent;
    color: $primary-darken-1;
    pointer: ns-resize;  /* vertical divider — bidirectional vertical arrow */
}
ResizeHandle.-vertical:hover {
    background: transparent;
    color: $primary;
}
ResizeHandle.-vertical.-dragging {
    background: transparent;
    color: $accent;
    pointer: grabbing;
}
