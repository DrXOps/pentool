/* Toolbar — единый стиль для всех тулбаров. */
Toolbar {
    height: auto;
    min-height: 2;
    /* No fill: a toolbar is a row of controls, not a block. The `$panel` shade
       made every action row (Intruder's threads/delay, Positions/Payloads,
       Target's Scope/Crawl/Clear, Scanner, Recon) look like an older design
       stacked inside the cards. Chrome sits on the window background and is
       separated by lines, same as the module header and the footer. */
    background: transparent;
    layout: horizontal;
    padding: 0 1;
    align: left middle;
    /* Широкий тулбар прокручивается, а не обрезает правые кнопки
       (именно из-за обрезки «Smart…» уезжала за край). */
    overflow-x: auto;
    /* Цвет — как у рамки карточек: линии под тулбарами и под полосой модулей
       больше не отличаются от рамок блоков. */
    border-bottom: solid $primary 35%;
}

/* Разделитель между кнопками — компактный */
Toolbar .toolbar-sep {
    min-width: 1;
    width: auto;
    color: $primary-darken-2;
}

/* Все Input внутри тулбара — compact (height: 1) */
Toolbar Input {
    height: 1;
}

/* Все ToolbarButton внутри — без рамок, вплотную к сепу */
Toolbar ToolbarButton {
    margin: 0 0 0 1;
}

/* Все Label внутри — строчные */
Toolbar Label {
    height: 1;
}

/* Checkbox внутри тулбара */
Toolbar Checkbox {
    height: 1;
}

/* Horizontal внутри тулбара (для вложенных групп) */
Toolbar Horizontal {
    height: 1;
    layout: horizontal;
    align: left middle;
}