/* Toolbar — единый стиль для всех тулбаров. */
Toolbar {
    height: auto;
    min-height: 2;
    background: $panel;
    layout: horizontal;
    padding: 0 1;
    align: left middle;
    border-bottom: solid $primary-darken-2;
}

/* Разделитель между кнопками — компактный */
Toolbar .toolbar-sep {
    min-width: 1;
    width: auto;
    color: $primary-darken-2;
}

/* Все Input внутри тулбара — compact (height: 1) */
Toolbar Input {
    height: 1;
}

/* Все ToolbarButton внутри — без рамок, вплотную к сепу */
Toolbar ToolbarButton {
    margin: 0 0 0 1;
}

/* Все Label внутри — строчные */
Toolbar Label {
    height: 1;
}

/* Checkbox внутри тулбара */
Toolbar Checkbox {
    height: 1;
}

/* Horizontal внутри тулбара (для вложенных групп) */
Toolbar Horizontal {
    height: 1;
    layout: horizontal;
    align: left middle;
}