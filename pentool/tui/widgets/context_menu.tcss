ContextMenu {
    layer: overlay;
    position: absolute;
    width: auto;
    height: auto;
    max-height: 40;
    min-width: 30;
    background: $panel;
    border: solid $primary;
    padding: 0;
    overflow-y: auto;
}
ContextMenu .ctx-item {
    width: 100%;
    padding: 0 2;
    height: 1;
    color: $text;
    pointer: pointer;
}
ContextMenu .ctx-item:hover {
    background: $primary;
    color: $text;
}
ContextMenu .ctx-item.-focused {
    background: $primary;
    color: $text;
}
ContextMenu .ctx-sep {
    width: 100%;
    height: 1;
    color: $primary-darken-2;
    padding: 0 1;
    pointer: default;
}
