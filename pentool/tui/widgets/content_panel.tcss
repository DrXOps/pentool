ContentPanel {
    height: auto;
    width: 1fr;
    layout: vertical;
}
ContentPanel > .cp-title {
    /* height/background/padding — из общего .panel-title (F-038). */
    layout: horizontal;
    align: left middle;
}
ContentPanel > .cp-title > Static {
    width: 1fr;
    height: 1;
    /* Section headers in the cards UI: `┌─ REQUEST ─`, accent + bold. */
    color: $accent;
    text-style: bold;
}
/* Кнопки в заголовке */
ContentPanel > .cp-title > ToolbarButton {
    width: auto;
    min-width: 4;
    height: 1;
    padding: 0;
    background: transparent;
    border: none;
    pointer: pointer;
}
ContentPanel > .cp-title > ToolbarButton:focus {
    border: none;
}
ContentPanel > #cp-body {
    height: 1fr;
    min-height: 6;
    background: transparent;
}
ContentPanel RichLog {
    border: none;
    padding: 0 1;
    height: 1fr;
    min-height: 6;
    /* Panels sit inside cards: their body must not paint a lighter block, or the
       card reads as two different designs stacked. */
    background: transparent;
}
ContentPanel RichLog:focus {
    border: none;
    outline: none;
}
ContentPanel TextArea {
    border: none;
    height: 1fr;
    min-height: 6;
    background: transparent;
}
ContentPanel TextArea:focus {
    border: none;
    outline: none;
}
