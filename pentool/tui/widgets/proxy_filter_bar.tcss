HistoryFilterBar {
    /* height: 1 было служебной полосой; в карточке рамка добавляет строку
       сверху и снизу, поэтому высота — по содержимому блока. */
    height: auto;
    layout: horizontal;
    background: transparent;
}
HistoryFilterBar .fb-label {
    width: auto;
    height: 1;
    color: $text-muted;
    padding: 0 1 0 0;
}
HistoryFilterBar Input {
    height: 1;
    border-left: solid $primary-darken-1;
    border-right: solid $primary-darken-1;
    background: $surface-lighten-1;
    padding: 0 1;
    color: $text;
}
HistoryFilterBar Input:focus {
    border-left: solid $primary;
    border-right: solid $primary;
    background: $surface-lighten-2;
}
HistoryFilterBar #fb-host   { width: 10; }
HistoryFilterBar #fb-url    { width: 20; }
HistoryFilterBar #fb-status { width: 6; }
HistoryFilterBar #fb-search {
    /* Фиксированная ширина: `1fr` растягивал поле на весь остаток строки. */
    width: 10;
}
HistoryFilterBar #fb-apply {
    height: 1;
    width: auto;
    min-width: 7;
    background: $primary-darken-1;
    border: none;
    padding: 0 1;
}
HistoryFilterBar #fb-reset {
    height: 1;
    width: auto;
    min-width: 7;
    background: $panel;
    border: none;
    padding: 0 1;
}
HistoryFilterBar .fb-sep {
    width: 1;
    height: 1;
    color: $primary-darken-2;
}
HistoryFilterBar OptionCycler {
    height: 1;
    /* Method и Mark: ровно вдвое короче прежних 7 — по просьбе. */
    width: 4;
    background: $panel;
    color: $text;
    padding: 0 1;
    pointer: pointer;
}
HistoryFilterBar OptionCycler:hover {
    background: $primary-darken-1;
}
HistoryFilterBar ToolbarButton {
    height: 1;
    width: auto;
    min-width: 3;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
    pointer: pointer;
}
HistoryFilterBar ToolbarButton:hover {
    background: $primary-darken-1;
}
HistoryFilterBar ToolbarButton.-active {
    color: $success;
    background: $success-darken-3;
}
HistoryFilterBar ToolbarButton.disabled {
    color: $text-disabled;
    background: $panel;
    opacity: 0.5;
}
