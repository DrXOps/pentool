HistoryFilterBar {
    /* height: 1 было служебной полосой; в карточке рамка добавляет строку
       сверху и снизу, поэтому высота — по содержимому блока. */
    height: auto;
    layout: horizontal;
    background: transparent;
}
/* Два логических ряда (поля / действия) лежат в ряд, пока влезают; на узкой
   полосе класс `.-two-rows` (его ставит сам виджет по своей ширине) меняет
   раскладку на вертикальную — тогда фильтры в одной строке, тоглы и кнопки в
   другой. Слова на тоглах («Scope»/«In scope», «Comments»/«Commented») стоят
   ширины: в одну строку они влезают только от ~113 клеток. */
HistoryFilterBar .fb-row {
    width: auto;
    height: auto;
    layout: horizontal;
}
HistoryFilterBar.-two-rows {
    layout: vertical;
}
HistoryFilterBar .fb-label {
    width: auto;
    height: 1;
    color: $text-muted;
    padding: 0 1 0 0;
}
HistoryFilterBar Input {
    height: 1;
    border-left: solid $primary-darken-1;
    border-right: solid $primary-darken-1;
    background: $surface-lighten-1;
    padding: 0 1;
    color: $text;
}
HistoryFilterBar Input:focus {
    border-left: solid $primary;
    border-right: solid $primary;
    background: $surface-lighten-2;
}
HistoryFilterBar #fb-host   { width: 8; }
HistoryFilterBar #fb-url    { width: 10; }
HistoryFilterBar #fb-status { width: 6; }
HistoryFilterBar #fb-search {
    /* Фиксированная ширина: `1fr` растягивал поле на весь остаток строки. */
    width: 7;
}
HistoryFilterBar #fb-apply {
    height: 1;
    width: auto;
    min-width: 7;
    /* Button's DEFAULT_CSS carries `line-pad: 1`, which already insets the
       label by one cell on each side ("Filter" = 6 + 2 = 8 cells). Our own
       horizontal padding was a second inset on top of that and made the button
       10 cells wide; dropping it is what buys the room. `line-pad: 0` is not an
       option: Textual's integer parser rejects 0 for that property. */
    background: $primary-darken-1;
    border: none;
    padding: 0;
}
HistoryFilterBar #fb-reset {
    height: 1;
    width: auto;
    min-width: 7;
    background: $panel;
    border: none;
    padding: 0;
}
HistoryFilterBar .fb-sep {
    width: 1;
    height: 1;
    color: $primary-darken-2;
}
HistoryFilterBar OptionCycler {
    height: 1;
    /* OptionCycler's own DEFAULT_CSS pins `min-width: 14`, and min-width beats
       a plain `width`, so an earlier `width: 4` never took effect: Method and
       Mark kept eating 14 cells each. Both properties are set here so the bar,
       not the widget default, decides the width. 7 is the smallest value that
       shows the default "Any ▼" without clipping. */
    width: 7;
    min-width: 7;
    background: $panel;
    color: $text;
    padding: 0 1;
    pointer: pointer;
}
HistoryFilterBar OptionCycler:hover {
    background: $primary-darken-1;
}
HistoryFilterBar ToolbarButton {
    height: 1;
    width: auto;
    min-width: 3;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
    pointer: pointer;
}
HistoryFilterBar ToolbarButton:hover {
    background: $primary-darken-1;
}
HistoryFilterBar ToolbarButton.-active {
    color: $success;
    background: $success-darken-3;
}
HistoryFilterBar ToolbarButton.disabled {
    color: $text-disabled;
    background: $panel;
    opacity: 0.5;
}
