HttpView {
    height: 1fr;
    layout: vertical;
    border: none;
}
HttpView TextArea {
    height: 1fr;
    border: none;
    pointer: text;
    /* Inside a card: the editor must not paint its own lighter surface. */
    background: transparent;
}

RequestEditor {
    height: 1fr;
    border: solid $primary-darken-2;
    layout: vertical;
}
RequestEditor TextArea {
    height: 1fr;
    border: none;
    pointer: text;
    background: transparent;
}

ResponseViewer {
    height: 1fr;
    border: solid $primary-darken-2;
    layout: vertical;
}
ResponseViewer TextArea {
    height: 1fr;
    border: none;
    pointer: text;
    background: transparent;
}