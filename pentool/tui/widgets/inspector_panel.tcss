InspectorPanel {
    width: 30%;
    overflow-y: auto;
    padding: 0;
    background: $surface;
}
InspectorPanel .section-title {
    height: 1;
    background: $primary-darken-3;
    color: $text-muted;
    padding: 0 1;
    text-style: bold;
}
InspectorPanel .kv-row {
    height: 1;
    padding: 0 1;
    color: $text;
}
InspectorPanel .empty-msg {
    color: $text-muted;
    padding: 0 2;
    height: 1;
}
InspectorPanel #inspector-placeholder {
    padding: 1 2;
    color: $text-muted;
}
