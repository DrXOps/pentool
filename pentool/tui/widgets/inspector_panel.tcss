InspectorPanel {
    width: 30%;
    overflow-y: auto;
    padding: 0;
    background: transparent;
}
InspectorPanel .section-title {
    /* height/background/padding — из общего .panel-title (F-038). */
    color: $text-muted;
    text-style: bold;
}
InspectorPanel .kv-row {
    height: 1;
    padding: 0 1;
    color: $text;
}
InspectorPanel .empty-msg {
    color: $text-muted;
    padding: 0 2;
    height: 1;
}
InspectorPanel #inspector-placeholder {
    padding: 1 2;
    color: $text-muted;
}
