IntruderAutoMarkDialog {
    align: center middle;
}
IntruderAutoMarkDialog #dialog {
    width: 56;
    height: auto;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}
IntruderAutoMarkDialog #title {
    text-align: center;
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}
IntruderAutoMarkDialog #hint {
    color: $text-muted;
    margin-bottom: 1;
}
IntruderAutoMarkDialog #checks-grid {
    grid-size: 2;
    grid-gutter: 0 1;
    height: auto;
    margin-bottom: 1;
}
IntruderAutoMarkDialog .chk {
    height: 1;
    margin: 0;
    padding: 0;
}
IntruderAutoMarkDialog #buttons-row {
    layout: horizontal;
    height: auto;
    align: center middle;
    margin-top: 1;
}
IntruderAutoMarkDialog #buttons-row ToolbarButton {
    margin: 0 1;
    padding: 0 2;
}