/* app.tcss — global styles for PentoolApp */

PentoolApp {
    layout: vertical;
    layers: overlay;
}

/* Верхняя полоса модулей: одна строка подписей + линия под ней. Геометрия
   живёт здесь, чтобы не было двух владельцев (module_tabs.tcss держит цвета). */
ModuleTabs {
    height: 2;
    width: 100%;
}

ContentSwitcher {
    width: 1fr;
    height: 1fr;
}

ContentSwitcher > * {
    width: 1fr;
    height: 1fr;
}

/* Каждая вкладка занимает своего родителя целиком. Правило принадлежит
   здесь, а не трём экранам по отдельности: Intruder, Repeater и Settings
   держали по одинаковой копии `TabbedContent { height: 1fr }` (F-038). */
TabbedContent {
    height: 1fr;
}

/* Wrapper around GlobalHintBar + ModuleHintBar + StatusBar.
   Each child's DEFAULT_CSS hard-codes `dock: bottom` — overridden
   here with `dock: none` so they stack vertically. */
#bottom-dock {
    dock: bottom;
    /* Two content rows (hints + status) + one separator line. */
    height: 3;
    layout: vertical;
    /* Footer sits on the window background too, closed off from the content by
       one line in the card-frame colour. */
    background: transparent;
    border-top: solid $primary 35%;
}

/* Two rows now: the hints row (with its Global/Module switch) and the status
   bar. The former second hints row was merged into the switch. */
#bottom-dock #hints-row { dock: none; height: 1; }
#bottom-dock StatusBar { dock: none; height: 1; }

/* ── Hints row: [ Global ][ Module ]  keys… ────────────────────────────────
   One row instead of two: the switch changes the content of the same row, so
   the footer keeps its height while the user works. Scope defaults to the
   active module — those are the keys needed right now; the global keys are one
   click (or F2) away. */
#hints-row {
    height: 1;
    width: 100%;
    background: transparent;
}

#hints-row ToolbarButton {
    height: 1;
    width: auto;
    padding: 0 1;
    background: transparent;
    color: $text-muted;
}

#hints-row ToolbarButton:hover {
    background: $primary 25%;
}

#hints-row ToolbarButton.hints-chip-on {
    background: $primary 35%;
    color: $text;
    text-style: bold;
}

#hints-row #hints-text {
    width: 1fr;
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

/* Global checkbox style — compact, height 1, no border.
   Glyph itself ("[ ]" / "[✓]") is set once in Checkbox.BUTTON_LEFT/
   INNER/RIGHT above; this just controls color/spacing/hover so every
   screen gets the same look without per-screen overrides. */
Checkbox {
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    width: auto;
}

Checkbox > .toggle--button {
    color: $text-muted;
    background: transparent;
    text-style: bold;
}

Checkbox.-on > .toggle--button {
    color: $success;
    background: transparent;
    text-style: bold;
}

Checkbox:hover > .toggle--button {
    color: $primary;
}

Checkbox.-on:hover > .toggle--button {
    color: $success;
    text-style: bold;
}

Checkbox:focus {
    border: none;
    background: transparent;
}

Checkbox:focus > .toggle--label {
    color: $text;
    background: $primary-darken-3;
    text-style: none;
}

/* Панельный заголовок: одна строка, тёмная подложка, отступ по бокам.
   Раньше эти три свойства были скопированы в семи файлах (F-038). Всё, что
   отличается — цвет текста, жирность, раскладка, ширина — осталось в правилах
   конкретных виджетов; класс добавляется к виджету в Python. */
.panel-title {
    height: 1;
    background: $primary-darken-3;
    padding: 0 1;
}

/* ── Заголовки таблиц ─────────────────────────────────────────────────────
   Заголовок сортируемый (клик = сортировка), но по умолчанию Textual красит
   наведение в `$secondary 30%` поверх `$primary` — разницы не видно. Здесь
   подсветка акцентом: наведение на заголовок читается как «сюда можно
   нажать». Курсор-«рука» над заголовком переключается в
   `widgets/data_table.ArrowBackendDataTable.watch_hover_coordinate`. */
DataTable > .datatable--header-hover {
    background: $accent 35%;
    color: $text;
    text-style: bold;
}

/* ── Хром приложения: вкладки и подчёркивание ─────────────────────────────
   Один стиль на весь TUI: полоса модулей (`ModuleTabs`) и все `TabbedContent`
   во всех модулях получают одинаковый вид. По умолчанию Textual рисует под
   вкладками полосу `━` на всю ширину (`Underline` + `Bar`), и рядом с
   карточками она читалась как индикатор прогресса. Полосу убираем совсем:
   активная вкладка видна плашкой цвета карточной рамки, как блоки интерфейса.
   `display: none` вместо перекраски — `Bar` всё равно рисует символы `━`, а
   подкрасить их в цвет фона значит оставить мёртвую строку. */
Underline {
    display: none;
}
/* Строка вкладок теперь одна (подписи), без второй строки под полосу:
   у `Tabs`/`ContentTabs` по умолчанию высота 2. */
Tabs {
    height: 1;
}
Tab {
    color: $text-muted;
}
Tab:hover {
    color: $text;
    background: $primary 20%;
}
Tab.-active {
    color: $accent;
    text-style: bold;
    background: $primary 20%;
}
/* Tabs:focus перекрашивает активную вкладку в курсорные цвета — возвращаем
   «карточный» вид, иначе при фокусе стиль снова расходится с остальным UI. */
Tabs:focus Tab.-active {
    color: $accent;
    text-style: bold;
    background: $primary 20%;
}

/* ── Карточки (ветка feature/tui-cards-proxy) ─────────────────────────────
   Один владелец скруглений. Правила лежат здесь, потому что Textual
   префиксует первый селектор DEFAULT_CSS типом виджета
   (textual/css/parse.py:174) — класс, написанный в tcss экрана или виджета,
   не совпадёт ни с чем. */
/* Полоса с адресом/фильтрами: белая рамка, скруглённые края.
   Цвет именно $foreground: `$text` в палитре Textual нет (есть
   $text-muted/$text-disabled), а на несуществующей переменной парсер падает
   с «Invalid value for border property» и роняет всё приложение. */
.card-host {
    background: transparent;
    border: round $foreground;
}
/* Обычная карточка: та же белая рамка, что у `.card-host`, чтобы блоки на
   экране не спорили цветом. Вертикального padding нет — карточки оборачивают
   таблицы и панели, где лишние строки отнимают место у содержимого.
   `transition` НЕ ставим: анимация рамки держит кадры 160 мс после каждого
   наведения/клика. Замер: клик по кнопке в полосе — 335 мс с анимацией против
   257 мс без неё, и это на каждом действии. */
.card {
    background: transparent;
    border: round $foreground;
    padding: 0 1;
}
.card:hover {
    border: round $accent;
}

/* Override Textual's built-in toast: replace the default vertical
   severity stripe on the left edge with a full border all the way round,
   and force every toast onto a single line — long text is truncated with
   an ellipsis rather than wrapping. */
Toast {
    border: none;
    text-wrap: wrap;
    padding: 0 1;
}

Toast.-information { border: round $accent; }
Toast.-success     { border: round $success; }
Toast.-warning     { border: round $warning; }
Toast.-error       { border: round $error; }
Toast.-critical    { border: heavy $error; }

/* ── Narrow terminal (NARROW_BREAKPOINT, F-027/ADR-7) ──────────────────────
   PentoolApp.on_resize() sets the `narrow` class on the active Screen; only
   the layout reacts, the user's own toggles never do. Rules live here, in the
   app's global stylesheet, because Textual prefixes the first selector of a
   widget's DEFAULT_CSS with that widget's type (textual/css/parse.py:174) —
   a `Screen.narrow …` rule written in a screen's own .tcss would be parsed as
   `<ThatScreen> Screen.narrow …` and never match. */

/* ── Разделитель в тулбарах: один владелец ────────────────────────────────
   Раньше правило лежало в DEFAULT_CSS ToolbarButton, а Textual префиксует
   первый селектор типом виджета — выходило `ToolbarButton .toolbar-sep`,
   что не совпадает с соседним Static. Цвет применялся только внутри
   `Toolbar .toolbar-sep`, поэтому в экранах, где разделитель лежит прямо
   в Horizontal (сканер), он рисовался цветом текста — отсюда «другой
   цвет» в сканере. */
.toolbar-sep {
    width: auto;
    min-width: 1;
    color: $primary-darken-2;
}

/* ── Module header (row 1 state, row 2 actions/tabs/more) ──────────────────
   Row 1 lives inside #module-bar, next to the module tabs; row 2 is
   #module-header, hidden for modules that describe no header (Dashboard).
   Screens describe it via `HeaderSpec` (pentool/tui/header.py) and never
   compose their own toolbar. */
#module-bar {
    height: 2;
    width: 100%;
}

#module-bar ModuleTabs {
    width: 1fr;
}

#hdr-state {
    height: 1;
    width: auto;
    align-vertical: top;
    padding: 0 1;
}

#hdr-counters {
    height: 1;
    width: auto;
    padding: 0 1;
    color: $accent;
}

#module-header {
    /* One content row + one separator line: a 1-row box with a border would leave
       no room for the buttons (content height 0), which made the header look
       empty and swallow every click. */
    height: 2;
    width: 100%;
    /* Chrome has no fill of its own: it sits on the window background, separated
       from the content by one line in the card-frame colour. */
    background: transparent;
    border-bottom: solid $primary 35%;
}

#hdr-actions {
    height: 1;
    width: auto;
}

#hdr-tabs {
    height: 1;
    width: 1fr;
    padding: 0 1;
}

#hdr-more-zone {
    height: 1;
    width: auto;
    padding: 0 1;
}

#module-header ToolbarButton {
    height: 1;
    width: auto;
    padding: 0 1;
    background: transparent;
    color: $text;
}

#module-header ToolbarButton:hover {
    background: $primary 25%;
}

#module-header ToolbarButton.hdr-tab {
    color: $text-muted;
}

#module-header ToolbarButton.hdr-tab.hdr-tab-on {
    background: $primary 55%;
    color: $text;
    text-style: bold;
}

#hdr-state ToolbarButton {
    height: 1;
    width: auto;
    padding: 0 1;
    background: transparent;
    color: $text-muted;
}

#hdr-state ToolbarButton:hover {
    background: $primary 25%;
}

#hdr-state ToolbarButton.hdr-state-on {
    color: $success;
    text-style: bold;
}

#hdr-state ToolbarButton.hdr-state-off {
    color: $text-muted;
}

/* ── Общее поле программы (2026-11-17, рамка окна — 2026-11-20) ────────────
   Раньше отступы от краёв задавались внутри конкретных экранов: у дашборда
   карточки стояли с полями, а proxy/intruder/target прилипали к краям, и
   «рамка» приложения выглядела по-разному в каждом модуле. Теперь внешняя
   граница одна: скруглённая рамка окна (#app-shell) тем же цветом и формой,
   что у карточек внутри. Экранное поле при этом убрано — рамка и есть поле. */

Screen {
    padding: 0;
}

/* Окно-карточка: вкладки модулей, содержимое и низ живут внутри одной рамки.
   `round $foreground` — тот же цвет, что у `.card`/`.card-host`, поэтому
   вложенные карточки читаются как блоки внутри блока, а не как чужая рамка. */
#app-shell {
    background: transparent;
    border: round $foreground;
    padding: 0 1;
}

/* Диалоги — отдельные окна поверх, у них своя рамка. */
ModalScreen {
    padding: 0;
}

/* Узкий терминал: поле окна убирается, колонки уходят содержимому. Рамка
   остаётся (одна клетка с каждой стороны), иначе окно перестаёт быть карточкой. */
Screen.narrow {
    padding: 0;
}
Screen.narrow #app-shell {
    padding: 0;
}

/* Narrow terminal: the inspector is the first thing to go, but
   `_inspector_visible` is untouched — widening the terminal brings it back. */
Screen.narrow ProxyScreen InspectorPanel.-visible {
    display: none;
}
