# PRO files — live in pro/ submodule (docxqwerty/pentool-pro)
# These are NOT in the public pentool repo; they are delivered via
# 'pentool license activate' → downloaded to ~/.pentool/pro/ from
# the private GitHub Release built by pentool-pro CI.
pentool/modules/scanner/
pentool/modules/intruder_turbo.py
pentool/plugins/builtin/payloads_pro.py
pentool/plugins/builtin/reports_pro.py
pentool/plugins/builtin/scanner_pro.py
