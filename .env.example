# .env.example — шаблон. Скопируйте в .env и заполните.
#   cp .env.example .env
# .env в .gitignore и защищён хуком protect-secrets.sh (агент его не прочитает).
# Здесь только фиктивные значения — настоящих секретов в этом файле быть не должно.

# --- Тесты ----------------------------------------------------------------
# Команда полного прогона. Используется scripts/run-tests.sh и pre-commit.
# pentool: зависимости ставятся через uv (uv.lock), поэтому `uv run` гарантирует
# нужное окружение. Полный прогон — `uv run pytest -q`; unit-набор в Stop-хуке —
# `uv run pytest tests/unit -q` (см. TEST_COMMAND в .claude/hooks/config.env).
TEST_CMD="uv run pytest tests/unit -q"

# --- Windows-тесты по SSH (из WSL) ----------------------------------------
# Если целевое приложение кроссплатформенное и Windows-часть тестируется
# удалённо. Stop-хук вызовет эти переменные, только если изменены
# Windows-специфичные файлы (см. require-quality-gate.sh, шаг 4).
#
# Настройка (один раз):
#   1. ssh-copy-id <user>@<windows-host>        # ключ без пароля
#   2. Проверка: ssh "$WIN_HOST" powershell.exe -Command "echo ok"
#   3. WIN_TEST_SCRIPT — путь в Windows-нотации, как его видит PowerShell.
#
# WIN_HOST=user@192.168.1.50
# WIN_TEST_SCRIPT=C:\projects\myapp\scripts\run-tests.ps1

# --- AI-автоматизация (ai/) ----------------------------------------------
# Эндпоинты и модели НЕ хардкодятся: ai/models.yaml ссылается на эти
# переменные. Без них облачные модели недоступны (ai/run упадёт с понятной
# ошибкой), локальные — работают, если Ollama запущена.
#
# Локальная модель (Ollama). Проверка: curl "$OLLAMA_ENDPOINT/api/tags"
# OLLAMA_ENDPOINT=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# Anthropic-совместимый шлюз (Claude Code и ai/run ходят одним и тем же путём).
# ANTHROPIC_BASE_URL=http://127.0.0.1:3456
# ANTHROPIC_AUTH_TOKEN=<введите свой токен — не коммитится>
# Переопределения имён моделей (по умолчанию — из ai/models.yaml):
# AI_MODEL_DEEPSEEK_FLASH=deepseek/deepseek-v4.1-flash
# AI_MODEL_DEEPSEEK_PRO=deepseek/deepseek-v4-pro-0813
# AI_MODEL_QWEN_CLOUD=qwen/qwen3.7-flash
# AI_MAX_TOKENS=1024

# --- Изоляция worktree (scripts/ai/worktree) ------------------------------
# AI_WORKTREE_DIR=.worktrees     # каталог рабочих копий (в .gitignore)
# AI_PORT_BASE=9100              # парку портов на worktree: PORT_BASE + индекс*10
# AI_BRANCH_PREFIX=ai            # ветки вида ai/<name>
# AI_SETUP_VENV=0                # 1 — создать .venv в worktree при `env`

# --- Хуки контекста (.claude/hooks/context-state.sh) ----------------------
# CONTEXT_KEEP=20                # сколько снапшотов состояния хранить
# CONTEXT_RESTORE_CHARS=4000     # лимит сводки, вставляемой в контекст
# Отключение авто-сжатия Claude Code (не нашего хука):
#   DISABLE_AUTO_COMPACT=1       # только авто-сжатие
#   DISABLE_COMPACT=1            # авто-сжатие и ручной /compact
# CLAUDE_CODE_AUTO_COMPACT_WINDOW=300k   # приоритетнее autoCompactWindow

# --- Прочее ---------------------------------------------------------------
# GUARD_GIT_ALLOW="path1,path2"   # разовое исключение для guard-git-staging;
#                                 # лучше задавать прямо в команде, а не здесь.
